# Local development uses the Vite proxy to keep the guest session cookie same-origin.
VITE_API_URL=/api
# Production builds should set VITE_API_URL to the absolute backend URL, including /api.

# 'include' lets the API read Laravel session cookies (needed for the guest
# cart). Use 'omit' if the backend CORS does not allow credentials.
VITE_API_CREDENTIALS=include

# Used when the request fails and the user is bounced to /login.
VITE_PUBLIC_URL=

# Currency + locale formatting (frontend display only; the server owns prices).
VITE_CURRENCY=EGP
VITE_LOCALE_AR=ar-EG
VITE_LOCALE_EN=en-US